LilycoveCity_House4_MapScripts::
	.byte 0

LilycoveCity_House4_EventScript_Man1::
	msgbox LilycoveCity_House4_Text_MysteriesAtBottomOfSea, MSGBOX_NPC
	end

LilycoveCity_House4_EventScript_Man2::
	msgbox LilycoveCity_House4_Text_UnderwaterTrenchMossdeepSootopolis, MSGBOX_NPC
	end

LilycoveCity_House4_Text_MysteriesAtBottomOfSea:
	.string "The biggest mysteries in the world\n"
	.string "are at the bottom of the sea.\p"
	.string "My dad crewed for CAPT. STERN. He\n"
	.string "said they found a cavern down there\l"
	.string "that hummed. Like it was breathing.$"

LilycoveCity_House4_Text_UnderwaterTrenchMossdeepSootopolis:
	.string "There's a deep trench between\n"
	.string "MOSSDEEP and SOOTOPOLIS.\p"
	.string "CAPT. STERN mapped it. He said\n"
	.string "the water down there is warm. Too\l"
	.string "warm.\p"
	.string "Like something big is breathing\n"
	.string "under it.$"

