+# WJ (Project ARIA K7): the tilesets FireRed's layouts use - 640-metatile primaries, 32-bit attributes
+def _frlg_tilesets():
+    with open(os.path.join(ROOT, "data", "layouts", "layouts.json"), encoding="utf-8") as f:
+        out = set()
+        for e in json.load(f)["layouts"]:
+            if e.get("layout_version") == "frlg":
+                out.add(e.get("primary_tileset"))
+                out.add(e.get("secondary_tileset"))
+    return out
+
+
+FRLG_TILESETS = _frlg_tilesets()
+
+
+def split_for(primary):
+    """Where a layout's metatiles go over from its primary tileset to its secondary."""
+    return 640 if primary in FRLG_TILESETS else NUM_PRIMARY
+
+
+def read_attr16(tileset):
+    """A tileset's metatile attributes in Emerald's 16-bit form (FireRed's are 32-bit: behaviour bits 0-8,
+    layer type bits 29-30)."""
+    if tileset not in FRLG_TILESETS:
+        return read_u16(ATTRIBUTES[tileset])
+    raw = open(ATTRIBUTES[tileset], "rb").read()
+    vals = struct.unpack("<%dI" % (len(raw) // 4), raw[:len(raw) // 4 * 4])
+    return [(v & 0xFF) | (((v >> 29) & 3) << 12) for v in vals]
+
