+
+
+def house3_room():
+    # tatami like Mr. Briney's: a low table on four short legs (his), and the flat square cushions round
+    # it, a few pixels thick; House4 draws the same tile for tile
+    mat = tuple(c for c in BRINEY_FLOOR if c != "414a6a")
+    return [
