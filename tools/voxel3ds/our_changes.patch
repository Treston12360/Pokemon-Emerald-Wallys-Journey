+        piece("table", [(65, 65, 95, 96)], 7, leave=fl, solid=True, legs=4),
+        piece("cupboard", [(16, 16, 32, 40)], 16, leave=wl, back=32, side="plain"),
+        piece("shelf", [(33, 11, 56, 40)], 21, leave=wl, back=32),
+        piece("sink", [(96, 23, 128, 40)], 8, leave=wl, against=32, side="plain"),
+        piece("fridge", [(128, 10, 144, 40)], 24, leave=wl, back=32, side="plain"),
+    ])
+
+
+def stevens_room():
+    # a long table (Dewford hall's, longer) and two glass cases on legs against the east wall
+    fl = GENERIC_FLOOR
+    return [
+        piece("table", [(66, 48, 128, 79)], 8, leave=fl, solid=True, legs=4),
+        piece("case_n", [(160, 51, 176, 79)], 16, leave=fl, solid=True, legs=13, side="plain"),
+        piece("case_s", [(160, 83, 176, 111)], 16, leave=fl, solid=True, legs=13, side="plain"),
+    ]
+
+
+def tables(*rects, height=9):
+    # House2's table (28 wide, a cell and three quarters deep, 9 tall on its four legs) and the rooms that
+    # draw it, or Dewford's hall's longer one, in their own tiles: one piece each
+    def build():
+        fl = FLAT_FLOOR + GENERIC_FLOOR + ("ffcd8b", "bdbda4", "73738b", "f68b62")
+        return [piece("table%s" % ("" if k == 0 else "_%d" % k), [r], height, leave=fl, solid=True)
+                for k, r in enumerate(rects)]
+    return build
+
+
+def flat1_2f_room():
+    # the long table, and a bed like Brendan's (its head a board behind the mattress)
+    return tables((34, 64, 78, 95))() + [
+        piece("bed", [(140, 80, 164, 104)], 7, leave=FLAT_FLOOR, solid=True),
+    ]
+
+
+def low_tables(*rects, jars=()):
+    # House3's low table on tatami (Mr. Briney's), where the cushions round it change its tiles;
+    # and Mr. Briney's jars
+    def build():
+        mat = tuple(c for c in BRINEY_FLOOR if c != "414a6a")
+        return ([piece("low_table%s" % ("" if k == 0 else "_%d" % k), [r], 7, leave=mat, solid=True, legs=3)
+                 for k, r in enumerate(rects)]
+                + [piece("jar_%d" % k, [r], 7, leave=mat, round="lathe") for k, r in enumerate(jars)])
+    return build
+
+
+def wandas_room():
+    # the wall between the rooms (Dewford's hall's, Rustboro's flats' partition) and a bed like Brendan's
+    return [
+        piece("partition", [(192, 0, 208, 95)], 27, solid=True),
+        piece("bed", [(238, 32, 260, 59)], 7, leave=FLAT_FLOOR + GENERIC_FLOOR, solid=True, legs=3),
+    ]
+
+
+def fossil_room():
+    # House1's glass case and a bookcase, standing a little out from the back wall
+    mat = tuple(c for c in BRINEY_FLOOR if c != "414a6a") + ("d5c54a", "ac8b39", "bdbda4")
+    return [
+        piece("case", [(80, 36, 112, 64)], 20, leave=mat, back=56),
+        piece("bookcase", [(112, 26, 144, 52)], 18, leave=mat, back=44),
+    ]
+
+
+def fortree_room():
+    # the tree's trunk the house is built round, standing up through the room from its roots
+    return [piece("trunk", [(48, 0, 80, 66)], 50, round="lathe", legs=False)]
+
+
+PLAIN_FURNITURE = {
