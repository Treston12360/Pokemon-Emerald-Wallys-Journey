+
+
+PACIFIDLOG_FLOOR = ("bdb431", "ded552", "9c9410", "7bb4bd", "acdee6")   # the planks, the rug
+PACIFIDLOG_WALL = ("bd8b31", "deac52", "ffeed5")
+
+
+def pacifidlog_room():
+    # House2's kitchen (cupboard, sink against the wall, fridge), Mr. Briney's jars, and a table with a
+    # wooden chair either end of it (House1's chairs: the back a slab on the outer side)
+    fl = PACIFIDLOG_FLOOR
+    wl = PACIFIDLOG_WALL + fl
+    return (house_chair("chair_nw", (49, 64, 53, 80), (53, 68, 63, 80), fl)
+            + house_chair("chair_sw", (49, 80, 53, 96), (53, 84, 63, 96), fl)
